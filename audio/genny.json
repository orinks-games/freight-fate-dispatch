{
  "out_dir": "assets/audio",
  "sr": 44100,
  "normalize": -9.0,
  "max_loudness": -12.0,
  "declick": true,
  "trim": true,
  "sounds": [
    {
      "out": "cursor.wav",
      "layers": [
        {
          "type": "sfx",
          "kind": "click",
          "gain": 0.55,
          "params": {
            "tone": 1600
          }
        }
      ],
      "fx": [
        {
          "type": "lowpass",
          "cutoff": 2800
        }
      ],
      "duration": 0.08
    },
    {
      "out": "activate.wav",
      "layers": [
        {
          "type": "sfx",
          "kind": "typewriter",
          "gain": 0.5
        }
      ],
      "fx": [
        {
          "type": "lowpass",
          "cutoff": 2400
        }
      ],
      "duration": 0.12
    },
    {
      "out": "success.wav",
      "layers": [
        {
          "type": "sfx",
          "kind": "success",
          "gain": 0.6,
          "params": {
            "freq": "C5",
            "up": 4,
            "wave": "sine"
          }
        }
      ]
    },
    {
      "out": "error.wav",
      "layers": [
        {
          "type": "sfx",
          "kind": "error",
          "gain": 0.45,
          "params": {
            "freq": 145,
            "dur": 0.18
          }
        }
      ],
      "fx": [
        {
          "type": "lowpass",
          "cutoff": 1200
        }
      ]
    },
    {
      "out": "phone.wav",
      "layers": [
        {
          "type": "sfx",
          "kind": "alarm",
          "gain": 0.52,
          "params": {
            "freq": 520,
            "freq2": 650,
            "rate": 5,
            "dur": 0.7,
            "wave": "sine"
          }
        }
      ],
      "fx": [
        {
          "type": "telephone",
          "drive": 1.2,
          "low": 300,
          "high": 2600
        }
      ]
    },
    {
      "out": "day_start.wav",
      "layers": [
        {
          "type": "sfx",
          "kind": "powerup",
          "gain": 0.5,
          "params": {
            "freq": "C4",
            "steps": 4,
            "step": 4,
            "rate": 0.06,
            "wave": "sine"
          }
        }
      ]
    },
    {
      "out": "day_close.wav",
      "layers": [
        {
          "type": "sfx",
          "kind": "powerdown",
          "gain": 0.48,
          "params": {
            "freq": "C5",
            "steps": 4,
            "rate": 0.065
          }
        }
      ],
      "fx": [
        {
          "type": "lowpass",
          "cutoff": 2200
        }
      ]
    }
  ]
}
